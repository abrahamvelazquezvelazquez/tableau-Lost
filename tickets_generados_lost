SCOPES = ["https://www.googleapis.com/auth/spreadsheets"]
creds = Credentials.from_service_account_file("credentials.json", scopes=SCOPES)
client = gspread.authorize(creds)

# Configuración de Hoja Principal
ID_HOJA_PRINCIPAL = "1tLAyayZkAWJ0XtyQWWILutdQ_8sr7rjf1VsXxcAuL4M"
NOMBRE_PESTAÑA_PRINCIPAL = "Seguimiento"

# Nueva Hoja 1: SEGUIMIENTOS TMWH
ID1 = "10OuyIzexaTIW-QnZ6Bo-Vkgh6qexjiTySmHDdijA_m8"
HOJA1_NOMBRE = "CG.2"

# Hoja 2: Tickets ICQA
ID2 = "1acrZzYBuvEjCQoMqIklzsvIZBfKHSfCo5zMPiNR-h0w"
HOJA2_NOMBRE = "indebidas"


def obtener_mapa_valor_directo(id_sheet, nombre_hoja, col_criterio, col_valor):
    """Abre la hoja especificada y mapea la clave con el valor directo (sin sumar)."""
    ext_ss = client.open_by_key(id_sheet)
    ext_sheet = ext_ss.worksheet(nombre_hoja)
    datos = ext_sheet.get_all_values()

    mapa = {}
    if not datos:
        return mapa

    for fila in datos:
        if len(fila) > max(col_criterio, col_valor):
            llave = str(fila[col_criterio]).strip()
            if llave and llave not in mapa:
                # Guardamos el texto o contenido directo de la columna
                mapa[llave] = str(fila[col_valor]).strip()

    return mapa


def obtener_mapa_suma_num(id_sheet, nombre_hoja, col_criterio, col_suma):
    """Mantiene la suma numérica para la hoja 2 (indebidas)."""
    ext_ss = client.open_by_key(id_sheet)
    ext_sheet = ext_ss.worksheet(nombre_hoja)
    datos = ext_sheet.get_all_values()

    mapa = {}
    if not datos:
        return mapa

    for fila in datos:
        if len(fila) > max(col_criterio, col_suma):
            llave = str(fila[col_criterio]).strip()
            if llave:
                try:
                    valor = float(fila[col_suma])
                except ValueError:
                    valor = 0.0

                mapa[llave] = mapa.get(llave, 0.0) + valor

    return mapa


def tickets_generados_shortage():
    ss_principal = client.open_by_key(ID_HOJA_PRINCIPAL)
    sheet_destino = ss_principal.worksheet(NOMBRE_PESTAÑA_PRINCIPAL)

    # 1. Obtener criterios de Columna E (Columna 5, Fila 2 en adelante)
    valores_e = sheet_destino.col_values(5)[1:]
    if not valores_e:
        print("No hay filas para procesar en la columna E.")
        return

    # 2. Búsqueda dinámica de columnas por encabezado en Fila 1
    encabezados = sheet_destino.row_values(1)
    col_cg = 0
    col_indebidas = 0

    for idx, header in enumerate(encabezados):
        clean_header = " ".join(str(header).split()).lower()
        if clean_header == "piezas con ticket cg":
            col_cg = idx + 1
        elif clean_header == "piezas con ticket indebidas":
            col_indebidas = idx + 1

    if col_cg == 0 or col_indebidas == 0:
        print("Error: No se encontró la columna 'Piezas con ticket CG' o 'Piezas con ticket indebidas'.")
        return

    # 3. Construir mapas
    # Mapa 1 (SEGUIMIENTOS TMWH - CG.2): Criterio Col C (Índice 2), Obtiene Valor Directo de Col E (Índice 4)
    mapa1 = obtener_mapa_valor_directo(ID1, HOJA1_NOMBRE, 2, 4)

    # Mapa 2 (Tickets ICQA - indebidas): Criterio Col A (Índice 0), Suma Numérica Col B (Índice 1)
    mapa2 = obtener_mapa_suma_num(ID2, HOJA2_NOMBRE, 0, 1)

    # 4. Mapear resultados
    resultados_cg = []
    resultados_indebidas = []

    for item in valores_e:
        criterio = str(item).strip()
        if not criterio:
            resultados_cg.append([""])
            resultados_indebidas.append([0])
        else:
            val1 = mapa1.get(criterio, "")
            val2 = mapa2.get(criterio, 0.0)

            val2_formatted = int(val2) if isinstance(val2, float) and val2.is_integer() else val2

            resultados_cg.append([val1])
            resultados_indebidas.append([val2_formatted])

    # 5. Escritura masiva
    fila_inicio = 2
    fila_fin = fila_inicio + len(valores_e) - 1

    col_cg_letter = gspread.utils.rowcol_to_a1(1, col_cg)[:-1]
    range_cg = f"{col_cg_letter}{fila_inicio}:{col_cg_letter}{fila_fin}"

    col_indebidas_letter = gspread.utils.rowcol_to_a1(1, col_indebidas)[:-1]
    range_indebidas = f"{col_indebidas_letter}{fila_inicio}:{col_indebidas_letter}{fila_fin}"

    sheet_destino.update(values=resultados_cg, range_name=range_cg)
    sheet_destino.update(values=resultados_indebidas, range_name=range_indebidas)

    print(f"Se actualizaron {len(valores_e)} filas en ambas columnas de tickets exitosamente.")


if __name__ == "__main__":
    tickets_generados_shortage()
